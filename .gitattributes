# Normalize line endings: LF in the repo, checked out natively.
* text=auto eol=lf

# Windows batch files must stay CRLF to run reliably.
*.bat text eol=crlf

# Binary assets — never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
